# Copy to .env.local and fill in values. Never commit real secrets.

# Supabase (browser + server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-only aliases for API routes
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# OpenAI (server only)
OPENAI_API_KEY=
# OPENAI_ORG_ID=
# OPENAI_PROJECT_ID=
# OPENAI_ASSISTANT_ID=

# Upstash Redis — required for AI rate limiting in production (20 req/user/hour)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional
# NEXT_PUBLIC_TEMPLATE_TENANT_ID=
