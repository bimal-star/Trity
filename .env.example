# Copy to .env.local and fill in values. Never commit real secrets.

# Bundle analyzer (run before version bumps or after adding heavy dependencies)
# Windows PowerShell:  $env:ANALYZE="true"; npm run build
# Mac/Linux:            ANALYZE=true npm run build
# Or cross-platform:   npm run analyze
# Output: .next/analyze/client.html, edge.html, nodejs.html

# Supabase (browser + server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-only aliases for API routes
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Server only — required for tenant hard-delete, impersonation API routes, etc.
# Supabase Dashboard → Project Settings → API → service_role (secret). Never expose to the client.
# Prefer .env.credentials (see .env.credentials.example) or add here:
# SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (server only)
OPENAI_API_KEY=
# OPENAI_ORG_ID=
# OPENAI_PROJECT_ID=
# OPENAI_ASSISTANT_ID=

# Upstash Redis — required for AI rate limiting in production (20 req/user/hour)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional
# NEXT_PUBLIC_TEMPLATE_TENANT_ID=
