{
  "name": "trity",
  "version": "0.3.2",
  "private": true,
  "description": "Trity app — local dev: npm run dev (Turbopack, :3100). If EADDRINUSE, stop the other process or npm run dev:3101. dev:webpack = webpack on :3100.",
  "scripts": {
    "clean:next": "node scripts/clean-next.cjs",
    "predev": "node scripts/check-dev-port.cjs 3100 && node scripts/ensure-next-dev-static.cjs",
    "dev": "node scripts/dev-notice.cjs && next dev -p 3100 --turbo",
    "predev:webpack": "node scripts/check-dev-port.cjs 3100 && node scripts/ensure-next-dev-static.cjs",
    "dev:webpack": "next dev -p 3100",
    "predev:turbo": "node scripts/check-dev-port.cjs 3100 && node scripts/ensure-next-dev-static.cjs",
    "dev:turbo": "next dev -p 3100 --turbo",
    "dev:3101": "node scripts/ensure-next-dev-static.cjs && next dev -p 3101 --turbo",
    "dev:clean": "npm run clean:next && npm run dev",
    "dev:clean:turbo": "npm run clean:next && npm run dev:turbo",
    "predev:3000": "node scripts/check-dev-port.cjs 3000 && node scripts/ensure-next-dev-static.cjs",
    "dev:3000": "next dev -p 3000 --turbo",
    "predev:3000:webpack": "node scripts/check-dev-port.cjs 3000 && node scripts/ensure-next-dev-static.cjs",
    "dev:3000:webpack": "next dev -p 3000",
    "build": "next build",
    "analyze": "cross-env ANALYZE=true npm run build",
    "analyze:win": "powershell -NoProfile -Command \"$env:ANALYZE='true'; npm run build\"",
    "check:bundle": "echo Run npm run analyze, then open .next/analyze/client.html for chunks over 200KB parsed (and edge.html for middleware).",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "version:bump": "node scripts/release-version.js",
    "version:patch": "node scripts/release-version.js patch",
    "version:minor": "node scripts/release-version.js minor",
    "version:major": "node scripts/release-version.js major",
    "release:patch": "node scripts/release-version.js patch --commit --tag",
    "release:minor": "node scripts/release-version.js minor --commit --tag",
    "release:major": "node scripts/release-version.js major --commit --tag",
    "generate:types": "node scripts/generate-types.js",
    "document:schema": "node scripts/document-schema.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "dompurify": "^3.3.1",
    "isomorphic-dompurify": "^2.35.0",
    "lucide-react": "^0.303.0",
    "next": "14.0.4",
    "openai": "^4.77.0",
    "papaparse": "^5.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.0.4",
    "@types/node": "^20.10.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "autoprefixer": "^10.4.16",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.0.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.4.32",
    "prettier": "^3.7.4",
    "supabase": "^2.70.5",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  }
}
